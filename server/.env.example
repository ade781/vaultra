# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection:
# For Local MySQL: mysql://root:@localhost:3306/vaultra
# For Supabase PostgreSQL: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="mysql://root:@localhost:3306/vaultra"

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Supabase Credentials (Use Placeholders in example files)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"
