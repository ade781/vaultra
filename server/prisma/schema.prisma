datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Item {
  id        Int      @id @default(autoincrement())
  title     String
  url       String   @db.Text
  creator   String?  @default("Anonim")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
