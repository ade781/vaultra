{
  "name": "vaultra",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Woodcraft Link & Asset Vault",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "vercel-build": "cd server && npm install && npx prisma generate && cd ../client && npm install && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "slugify": "^1.6.9",
    "prisma": "6.19.3"
  }
}